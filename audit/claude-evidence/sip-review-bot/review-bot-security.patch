diff --git a/src/__tests__/approval.test.ts b/src/__tests__/approval.test.ts
new file mode 100644
index 0000000..46045b5
--- /dev/null
+++ b/src/__tests__/approval.test.ts
@@ -0,0 +1,289 @@
+import { allSatisfied, applyReviews, finalizeRules } from "../approval";
+import { File, Rule } from "../types";
+import { readFileSync } from "fs";
+import { load } from "js-yaml";
+
+const HEAD = "head-sha";
+const OLD = "old-sha";
+
+const file = (filename: string, status = "modified"): File =>
+    ({ filename, status }) as File;
+
+const authorsRule = (filename: string, reviewers: string[]): Rule => ({
+    name: "authors",
+    reviewers,
+    min: 1,
+    pr_approval: true,
+    annotation: { file: filename },
+});
+
+const governanceRule = (filename: string, reviewers: string[], min: number) =>
+    ({
+        name: "unknown",
+        reviewers,
+        min,
+        pr_approval: true,
+        annotation: { file: filename },
+    }) as Rule;
+
+const approve = (login: string, commit_id = HEAD) => ({
+    login,
+    state: "APPROVED",
+    commit_id,
+});
+
+describe("zero-approval prevention", () => {
+    test("an empty editor list can never be satisfied", () => {
+        const rules = finalizeRules(
+            [governanceRule(".github/workflows/ci.yml", [], 0)],
+            { governance: [] },
+            [file(".github/workflows/ci.yml")],
+            false,
+        );
+        expect(rules[0].min).toBe(1);
+        const { rules: after } = applyReviews(rules, "outsider", HEAD, [
+            approve("outsider"),
+        ]);
+        expect(allSatisfied(after)).toBe(false);
+    });
+
+    test("a single editor list still needs one approval (floor(1/2) = 0 is raised to 1)", () => {
+        const rules = finalizeRules(
+            [governanceRule("README.md", ["owner"], Math.floor(1 / 2))],
+            { governance: ["owner"] },
+            [file("README.md")],
+            false,
+        );
+        expect(rules[0].min).toBe(1);
+        expect(
+            allSatisfied(applyReviews(rules, "outsider", HEAD, []).rules),
+        ).toBe(false);
+    });
+
+    test("a pull request that matches no rule needs a governance approval", () => {
+        const rules = finalizeRules(
+            [],
+            { governance: ["owner"] },
+            [file("SIPS/sip-1.md")],
+            false,
+        );
+        expect(rules).toMatchObject([
+            {
+                name: "governance",
+                reviewers: ["owner"],
+                min: 1,
+                annotation: { file: "SIPS/sip-1.md" },
+            },
+        ]);
+    });
+
+    test("a file not covered by any rule gets its own governance rule", () => {
+        const rules = finalizeRules(
+            [authorsRule("SIPS/sip-2.md", ["alice"])],
+            { governance: ["owner"] },
+            [file("SIPS/sip-2.md"), file("SIPS/sip-1.md")],
+            true,
+        );
+        expect(rules.map((rule) => rule.annotation.file).sort()).toEqual([
+            "SIPS/sip-1.md",
+            "SIPS/sip-2.md",
+        ]);
+        // Approval by the SIP-2 author does not carry the uncovered SIP-1 change.
+        const { rules: after } = applyReviews(rules, "carol", HEAD, [
+            approve("alice"),
+        ]);
+        expect(allSatisfied(after)).toBe(false);
+    });
+
+    test("an asset is covered by the rule of its proposal", () => {
+        const rules = finalizeRules(
+            [authorsRule("SIPS/sip-2.md", ["alice"])],
+            { governance: ["owner"] },
+            [file("SIPS/sip-2.md"), file("assets/sip-2/diagram.svg")],
+            true,
+        );
+        expect(rules).toHaveLength(1);
+    });
+});
+
+describe("self-approval prevention", () => {
+    test("the pull request author is never counted, even as a listed reviewer", () => {
+        const rules = finalizeRules(
+            [governanceRule("README.md", ["owner"], 1)],
+            { governance: ["owner"] },
+            [file("README.md")],
+            false,
+        );
+        expect(rules[0].pr_approval).toBe(false);
+        const { rules: after, approvedBy } = applyReviews(
+            rules,
+            "owner",
+            HEAD,
+            [approve("owner")],
+        );
+        expect(approvedBy.has("owner")).toBe(false);
+        expect(allSatisfied(after)).toBe(false);
+    });
+
+    test("author matching is case-insensitive", () => {
+        const rules = finalizeRules(
+            [governanceRule("README.md", ["owner"], 1)],
+            { governance: ["owner"] },
+            [file("README.md")],
+            false,
+        );
+        expect(
+            allSatisfied(
+                applyReviews(rules, "Owner", HEAD, [approve("OWNER")]).rules,
+            ),
+        ).toBe(false);
+    });
+});
+
+describe("imported author approvals", () => {
+    test("with author approval disabled, author handles grant no approval", () => {
+        const rules = finalizeRules(
+            [authorsRule("SIPS/sip-2.md", ["alice", "bob"])],
+            { governance: ["owner"] },
+            [file("SIPS/sip-2.md")],
+            false,
+        );
+        expect(rules[0].reviewers).toEqual(["owner"]);
+        expect(
+            allSatisfied(
+                applyReviews(rules, "carol", HEAD, [approve("alice")]).rules,
+            ),
+        ).toBe(false);
+        expect(
+            allSatisfied(
+                applyReviews(rules, "carol", HEAD, [approve("owner")]).rules,
+            ),
+        ).toBe(true);
+    });
+
+    test("with author approval explicitly enabled, a listed author approves", () => {
+        const rules = finalizeRules(
+            [authorsRule("SIPS/sip-2.md", ["alice"])],
+            { governance: ["owner"] },
+            [file("SIPS/sip-2.md")],
+            true,
+        );
+        expect(
+            allSatisfied(
+                applyReviews(rules, "carol", HEAD, [approve("alice")]).rules,
+            ),
+        ).toBe(true);
+    });
+
+    test("an author cannot approve their own pull request even when enabled", () => {
+        const rules = finalizeRules(
+            [authorsRule("SIPS/sip-2.md", ["alice"])],
+            { governance: ["owner"] },
+            [file("SIPS/sip-2.md")],
+            true,
+        );
+        expect(
+            allSatisfied(
+                applyReviews(rules, "alice", HEAD, [approve("alice")]).rules,
+            ),
+        ).toBe(false);
+    });
+});
+
+describe("unauthorized and invalid approvals", () => {
+    const twoEditors = () =>
+        finalizeRules(
+            [governanceRule("config/sip-editors.yml", ["ed1", "ed2"], 2)],
+            { governance: ["ed1", "ed2"] },
+            [file("config/sip-editors.yml")],
+            false,
+        );
+
+    test("approvals from unlisted accounts do not count", () => {
+        expect(
+            allSatisfied(
+                applyReviews(twoEditors(), "carol", HEAD, [
+                    approve("mallory"),
+                    approve("eve"),
+                ]).rules,
+            ),
+        ).toBe(false);
+    });
+
+    test("one reviewer approving twice counts once", () => {
+        expect(
+            allSatisfied(
+                applyReviews(twoEditors(), "carol", HEAD, [
+                    approve("ed1"),
+                    approve("ed1"),
+                ]).rules,
+            ),
+        ).toBe(false);
+    });
+
+    test("an approval of an older commit does not count", () => {
+        expect(
+            allSatisfied(
+                applyReviews(twoEditors(), "carol", HEAD, [
+                    approve("ed1"),
+                    approve("ed2", OLD),
+                ]).rules,
+            ),
+        ).toBe(false);
+    });
+
+    test("a later change request revokes an earlier approval", () => {
+        expect(
+            allSatisfied(
+                applyReviews(twoEditors(), "carol", HEAD, [
+                    approve("ed1"),
+                    approve("ed2"),
+                    {
+                        login: "ed2",
+                        state: "CHANGES_REQUESTED",
+                        commit_id: HEAD,
+                    },
+                ]).rules,
+            ),
+        ).toBe(false);
+    });
+
+    test("a later comment does not revoke an approval", () => {
+        expect(
+            allSatisfied(
+                applyReviews(twoEditors(), "carol", HEAD, [
+                    approve("ed1"),
+                    approve("ed2"),
+                    { login: "ed2", state: "COMMENTED", commit_id: HEAD },
+                ]).rules,
+            ),
+        ).toBe(true);
+    });
+
+    test("two distinct editors approving the head commit satisfy the rule", () => {
+        expect(
+            allSatisfied(
+                applyReviews(twoEditors(), "carol", HEAD, [
+                    approve("ed1"),
+                    approve("ed2"),
+                ]).rules,
+            ),
+        ).toBe(true);
+    });
+});
+
+describe("merge controls", () => {
+    const inputs = (
+        load(readFileSync(`${__dirname}/../../action.yml`, "utf8")) as {
+            inputs: { [key: string]: { default?: string } };
+        }
+    ).inputs;
+
+    test("auto-merge is disabled unless explicitly enabled", () => {
+        expect(inputs["auto-merge"].default).toBe("false");
+    });
+
+    test("author approval is disabled unless explicitly enabled", () => {
+        expect(inputs["author-approval"].default).toBe("false");
+    });
+});

diff --git a/src/approval.ts b/src/approval.ts
new file mode 100644
index 0000000..431bb6f
--- /dev/null
+++ b/src/approval.ts
@@ -0,0 +1,111 @@
+import { Config, File, Rule, RuleProcessed } from "./types.js";
+
+export type Review = {
+    login: string;
+    state: string;
+    commit_id?: string | null;
+};
+
+/** The proposal file whose rules cover an asset file, if any. */
+function coveringProposal(filename: string): string | undefined {
+    const match = filename.match(/^assets\/(sip|src)-([0-9]+)\//);
+    if (!match) return undefined;
+    return `${match[1] === "sip" ? "SIPS" : "SRCS"}/${match[1]}-${match[2]}.md`;
+}
+
+/**
+ * Normalize the rules produced for a pull request so that no rule can be satisfied without at
+ * least one approval from a listed reviewer.
+ *
+ * - Every changed file is covered by a rule; a file no rule covers needs one governance
+ *   approval (fail closed).
+ * - Unless author approval is explicitly enabled, approvals required from proposal authors are
+ *   required from governance reviewers instead.
+ * - Every rule needs at least one approval, even when its computed minimum is zero or when it
+ *   lists no reviewers (a rule with no reviewers can never be satisfied).
+ */
+export function finalizeRules(
+    rules: Rule[],
+    config: Config,
+    files: File[],
+    authorApproval: boolean,
+): RuleProcessed[] {
+    const governance = config.governance ?? [];
+    const covered = new Set(rules.map((rule) => rule.annotation.file));
+    const uncovered = files
+        .map((file) => file.filename)
+        .filter((filename) => {
+            const proposal = coveringProposal(filename);
+            return (
+                !covered.has(filename) &&
+                !(proposal !== undefined && covered.has(proposal))
+            );
+        });
+    const all: Rule[] = [
+        ...rules.map((rule) =>
+            rule.name === "authors" && !authorApproval
+                ? { ...rule, reviewers: governance }
+                : rule,
+        ),
+        ...uncovered.map((filename): Rule => ({
+            name: "governance",
+            reviewers: governance,
+            min: 1,
+            annotation: { file: filename },
+            labels: ["e-review"],
+        })),
+    ];
+    return all.map((rule): RuleProcessed => {
+        const reviewers = rule.reviewers.map((reviewer) =>
+            reviewer.toLowerCase(),
+        );
+        const min = Math.max(1, Math.min(rule.min, reviewers.length));
+        return {
+            ...rule,
+            reviewers,
+            // The pull request author never approves their own pull request.
+            pr_approval: false,
+            min,
+            label_min: min,
+        };
+    });
+}
+
+/**
+ * Apply reviews to the rules. Only the latest review of each reviewer counts, it must be an
+ * approval of the current head commit, and the pull request author is never counted.
+ */
+export function applyReviews(
+    rules: RuleProcessed[],
+    prAuthor: string,
+    headSha: string,
+    reviews: Review[],
+): { rules: RuleProcessed[]; approvedBy: Set<string> } {
+    const author = prAuthor.toLowerCase();
+    const latest = new Map<string, Review>();
+    for (const review of reviews) {
+        const login = review.login.toLowerCase();
+        if (login === author) continue;
+        // Comments do not replace an earlier approval or change request.
+        if (review.state === "COMMENTED") continue;
+        latest.set(login, review);
+    }
+    const approvedBy = new Set<string>();
+    for (const [login, review] of latest) {
+        if (review.state === "APPROVED" && review.commit_id === headSha) {
+            approvedBy.add(login);
+        }
+    }
+    const result = rules.map((rule): RuleProcessed => {
+        const approvals = rule.reviewers.filter((reviewer) =>
+            approvedBy.has(reviewer),
+        ).length;
+        return { ...rule, min: rule.min - approvals };
+    });
+    return { rules: result, approvedBy };
+}
+
+/** Whether every rule has received its required approvals. */
+export function allSatisfied(rules: RuleProcessed[]): boolean {
+    return rules.every((rule) => rule.min <= 0);
+}
